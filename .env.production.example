# ==============================================================================
# CIVICLY PRODUCTION ENVIRONMENT CONFIGURATION
# Add these variables to your Vercel Project Settings -> Environment Variables
# ==============================================================================

# --- Application Environment ---
APP_ENV=production

# --- Database (Neon PostgreSQL) ---
# Copy the pooled connection string from your Neon Console (dashboard.neon.tech):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Authentication & JWT Security ---
# Generate a strong 32+ character secret key (e.g., using openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_hex_string_32_characters_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS & Domains ---
# Comma-separated allowed frontend domains (or leave default for auto-detecting *.vercel.app)
FRONTEND_ORIGINS=https://smart-public-complaint.vercel.app

# --- AI Chatbot (Google Gemini) ---
AI_PROVIDER=google
GEMINI_API_KEY=AIzaSyDc3BgI7zfmD7mV0xXkB0nSkhgrzdZxLaM
AI_MODEL=gemini-3.1-flash-lite

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads

# --- Optional Services ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@civicly.app
MAPS_API_KEY=

# --- Frontend (Only needed if Frontend is deployed in a separate Vercel project) ---
# If deploying Frontend separately, set this in the Frontend Vercel project:
# VITE_API_BASE_URL=https://smart-public-complaint-api.vercel.app
