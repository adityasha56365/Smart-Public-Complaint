APP_ENV=development
DATABASE_URL=postgresql+psycopg2://civicly_user:CHANGE_ME@localhost:5432/civicly_db
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGINS=http://localhost:8443,http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# Email (optional — leave empty to disable email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@civicly.app

# Map (optional — leave empty to use manual location only)
MAPS_API_KEY=

# JanSahayak AI Chatbot
# Set AI_PROVIDER="google" or "openai" and fill GEMINI_API_KEY (or AI_API_KEY)
# Leave blank to use the built-in rule-based fallback (no external API key required)
AI_PROVIDER=google
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite


