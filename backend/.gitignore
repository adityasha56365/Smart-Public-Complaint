# Environment and secrets
.env
.env.*
!.env.example

# Python virtual environment
venv/
.venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Database files
*.db
*.sqlite3

# Uploads (ignore user uploaded files, keep .gitkeep)
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
